# URL pública do site (usada em OG, sitemap e JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.neoquim.com.br

# WhatsApp do botão flutuante — E.164 SEM o "+" e sem máscara
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_MESSAGE=

# ┌──────────────────────────────────────────────────────────────────────────┐
# │ ESTE ARQUIVO É VERSIONADO. Nunca coloque valor real aqui — só o formato. │
# │ Credencial de verdade vai em .env.local, que está no .gitignore.        │
# └──────────────────────────────────────────────────────────────────────────┘

# SMTP — transporte dos DOIS formulários (contato e canal de denúncias).
# NENHUMA destas pode ter prefixo NEXT_PUBLIC_: a senha da caixa vazaria para o
# bundle do navegador.
#
# Use o host do PROVEDOR, não o CNAME do domínio. No caso da Neoquim,
# smtp.neoquim.com.br é CNAME para smtp.zcs.jetmailx.com.br, mas o certificado
# cobre só *.zcs.jetmailx.com.br — conectar pelo CNAME quebra a validação TLS
# com ERR_TLS_CERT_ALTNAME_INVALID.
SMTP_HOST=
# 465 = SSL direto · 587 = STARTTLS
SMTP_PORT=465
# Sem valor, é deduzido da porta (465 -> true)
SMTP_SECURE=true
# E-mail COMPLETO da caixa, não só o usuário. Sem espaço no fim.
SMTP_USER=
# SEMPRE entre aspas: sem elas o parser de .env corta o valor no primeiro "#" e
# a senha chega truncada ao servidor, sem nenhum erro visível.
SMTP_PASSWORD=""
# Remetente. Sem valor, usa SMTP_USER — que é o certo na maioria dos casos:
# hospedagem compartilhada recusa relay de remetente diferente do autenticado,
# e o que passa cai em spam por SPF.
MAIL_FROM=

# Destino do lead comercial
CONTACT_EMAIL_TO=

# Canal de Denúncias — caixa PRÓPRIA, separada da comercial.
# O CEC-8.5 define que quem recebe e apura é RH/Diretoria, e que o sigilo do
# informante é preservado: denúncia de assédio ou fraude não pode cair na
# mesma caixa que recebe lead de vendas.
DENUNCIA_EMAIL_TO=

# Área restrita — /admin-fileconfig-neoquim
# Credencial única do administrador. Nenhuma destas pode ter prefixo NEXT_PUBLIC_.
# Senha SEMPRE entre aspas: sem elas o parser de .env corta o valor no primeiro
# "#" e a senha chega truncada ao servidor, sem nenhum erro visível.
ADMIN_USER=
ADMIN_PASSWORD="troque-por-uma-senha-forte"
# Assina o cookie de sessão. Mínimo 32 caracteres — gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Trocar este valor derruba todas as sessões abertas.
ADMIN_SESSION_SECRET=

# Vercel Blob — armazena o certificado ISO oferecido para download.
# Na Vercel, é injetado automaticamente ao conectar o store ao projeto.
BLOB_READ_WRITE_TOKEN=
